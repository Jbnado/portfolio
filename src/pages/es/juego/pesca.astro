---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Fishing from '../../../islands/fishing/Fishing';
import { t } from '../../../i18n/utils';
import es from '../../../i18n/es.json';
import '../../../styles/fishing.css';

const locale = 'es';
const alternates = {
  'pt-br': 'https://jbnado.dev/jogo/pesca',
  en: 'https://jbnado.dev/en/game/fishing',
  es: 'https://jbnado.dev/es/juego/pesca',
};
---

<BaseLayout
  locale={locale}
  title={t('game.title', locale)}
  description={t('game.description', locale)}
  canonical={alternates.es}
  alternates={alternates}
  showFooter={false}
>
  <div class="fishing-stage">
    <canvas class="fishing-sea" aria-hidden="true"></canvas>
    <div class="fishing-content">
      <h1>{t('game.title', locale)}</h1>
      <Fishing client:load texts={es.game} />
    </div>
  </div>
</BaseLayout>
