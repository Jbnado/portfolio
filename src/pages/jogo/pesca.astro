---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Fishing from '../../islands/fishing/Fishing';
import GameShowcase from "../../components/GameShowcase.astro";
import { t } from '../../i18n/utils';
import ptBr from '../../i18n/pt-br.json';
import { SITE_URL, gameUrl } from '../../utils/constants';
import '../../styles/fishing.css';

const locale = 'pt-br';
const alternates = {
  'pt-br': `${SITE_URL}${gameUrl('pt-br')}`,
  en: `${SITE_URL}${gameUrl('en')}`,
  es: `${SITE_URL}${gameUrl('es')}`,
};
---

<BaseLayout
  locale={locale}
  title={t('game.title', locale)}
  description={t('game.description', locale)}
  canonical={alternates['pt-br']}
  alternates={alternates}
>
  <div class="fishing-stage">
    <canvas class="fishing-sea" aria-hidden="true"></canvas>
    <div class="fishing-content">
      <GameShowcase locale={locale}>
        <Fishing client:load texts={ptBr.game} slot="jogar" />
      </GameShowcase>
    </div>
  </div>
</BaseLayout>
