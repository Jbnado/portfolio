---
import BlogPostPage from '../../components/BlogPostPage.astro';
import { getBlogPosts } from '../../utils/blog-content';

export async function getStaticPaths() {
  const posts = await getBlogPosts('pt-br');
  return posts.map((entry, i) => ({
    params: { slug: entry.data.urlSlug },
    // posts vem do mais novo pro mais velho, então o "anterior" na leitura é o índice seguinte
    props: { entry, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { entry, prev, next } = Astro.props;
---
<BlogPostPage entry={entry} locale="pt-br" prev={prev} next={next} />
