---
interface Props {
  value: number;
  suffix?: string;
  label: string;
  /** Quando presente, a linha inteira vira âncora para a seção que comprova o número. */
  href?: string;
}

const { value, suffix = '', label, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['stat-card', href && 'stat-card--link']} href={href}>
  <span class="stat-card-label">{label}</span>
  <span class="stat-card-value">
    <slot>{value}{suffix}</slot>
  </span>
</Tag>

<style is:global>
  /* Linha de ficha técnica: rótulo à esquerda, valor à direita, filete tracejado
     entre as linhas. O space-between é o que faz a linha ocupar a largura da
     coluna inteira — antes o conteúdo media 136px dentro de 403px. */
  .stat-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px dashed var(--color-border);
  }

  .stat-card:first-child {
    border-top: none;
  }

  /* O painel tinha zero links: a linha "CASE STUDIES 8" enunciava o diferencial
     do produto e não levava a lugar nenhum. Agora cada número aponta para a
     seção que o comprova — e o acento passa a marcar ação, como manda a Regra
     do Carimbo, em vez de decorar dado. */
  .stat-card--link {
    text-decoration: none;
    margin: 0 -0.5rem;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    transition: background-color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .stat-card--link:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .stat-card--link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .stat-card-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  /* 1.75rem, não 3rem: três numerais a 3rem carregavam mais área de acento que
     o próprio CTA, invertendo a Regra do Carimbo na dobra em que ela mais vale. */
  .stat-card-value {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    white-space: nowrap;
  }

  /* Dark mode */
  .dark .stat-card-value {
    text-shadow:
      0 0 12px rgba(97, 255, 202, 0.45),
      0 0 30px rgba(97, 255, 202, 0.18);
  }
</style>
