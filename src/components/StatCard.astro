---
interface Props {
  value: number;
  suffix?: string;
  label: string;
}

const { value, suffix = '', label } = Astro.props;
---

<div class="stat-card">
  <span class="stat-card-label">{label}</span>
  <span class="stat-card-value">
    <slot>{value}{suffix}</slot>
  </span>
</div>

<style is:global>
  /* Linha de ficha técnica: rótulo à esquerda, valor à direita, filete tracejado
     entre as linhas. O space-between é o que faz a linha ocupar a largura da
     coluna inteira — antes o conteúdo media 136px dentro de 403px. */
  .stat-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px dashed var(--color-border);
  }

  .stat-card:first-child {
    border-top: none;
  }

  .stat-card-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  /* 1.75rem, não 3rem: três numerais a 3rem carregavam mais área de acento que
     o próprio CTA, invertendo a Regra do Carimbo na dobra em que ela mais vale. */
  .stat-card-value {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    white-space: nowrap;
  }

  /* Dark mode */
  .dark .stat-card-value {
    text-shadow:
      0 0 12px rgba(97, 255, 202, 0.45),
      0 0 30px rgba(97, 255, 202, 0.18);
  }
</style>
