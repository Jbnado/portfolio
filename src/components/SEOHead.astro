---
import { t } from '../i18n/utils';
import { SITE_URL, PERSON_ID, rssUrl, type Locale } from '../utils/constants';

interface Props {
  locale?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  alternates?: Record<string, string>;
  ogType?: string;
  jsonLd?: unknown;
}

const {
  locale = 'pt-br',
  title = t('seo.title', locale),
  description = t('seo.description', locale),
  ogImage = '/og-image.png',
  canonical,
  alternates,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const ogLocaleMap: Record<string, string> = {
  'pt-br': 'pt_BR',
  en: 'en_US',
  es: 'es_ES',
};

const hreflangMap: Record<string, string> = {
  'pt-br': `${SITE_URL}/`,
  en: `${SITE_URL}/en/`,
  es: `${SITE_URL}/es/`,
};

const canonicalUrl = canonical ?? (hreflangMap[locale] ?? `${SITE_URL}/`);
// A capa do YouTube já vem absoluta. Prefixar geraria https://jbnado.dev/https://i.ytimg.com/...
const ogImageUrl = /^https?:\/\//.test(ogImage) ? ogImage : `${SITE_URL}${ogImage}`;
const ogLocale = ogLocaleMap[locale] ?? 'pt_BR';
const ogLocaleAlternates = Object.values(ogLocaleMap).filter((l) => l !== ogLocale);

const alternateLinks = alternates ?? hreflangMap;

/**
 * Identidade autoral do site, emitida em TODA página.
 *
 * `worksFor`, `alumniOf` e `email` foram confirmados pelo João em 2026-08-08.
 * O endereço aqui é o de contato profissional, diferente do mailto que a
 * ContactSection monta por JavaScript.
 */
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'João Bernardo',
  alternateName: 'Jbnado',
  jobTitle: 'Fullstack Developer',
  description: t('hero.description', locale),
  url: SITE_URL,
  image: `${SITE_URL}/jbnado.jpg`,
  email: 'contato@jbnado.dev',
  worksFor: {
    '@type': 'Organization',
    name: 'Verzel',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Fatec Ribeirão Preto',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ribeirão Preto',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  knowsAbout: [
    'TypeScript', 'JavaScript', 'React', 'Astro', 'Node.js', 'Go', 'Rust',
    'PostgreSQL', 'SQLite', 'Docker', 'Docker Swarm', 'Traefik', 'Prometheus',
    'Grafana', 'Tailwind CSS', 'Preact', 'Tauri', 'Cloudflare Workers',
    'Desenvolvimento web fullstack', 'Observabilidade', 'Segurança de aplicações',
  ],
  sameAs: [
    'https://linkedin.com/in/jbnado',
    'https://github.com/Jbnado',
    'https://www.youtube.com/@jbnad',
  ],
};
---

<!-- SEO: Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- SEO: Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((alt) => (
  <meta property="og:locale:alternate" content={alt} />
))}
<meta property="og:site_name" content="João Bernardo" />

<!-- SEO: Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- SEO: hreflang -->
<!-- Só emite a linha do idioma que realmente existe. Um post publicado em
     apenas uma língua geraria <link hreflang="en"> sem href. -->
{alternateLinks['pt-br'] && <link rel="alternate" hreflang="pt-BR" href={alternateLinks['pt-br']} />}
{alternateLinks['en'] && <link rel="alternate" hreflang="en" href={alternateLinks['en']} />}
{alternateLinks['es'] && <link rel="alternate" hreflang="es" href={alternateLinks['es']} />}
{alternateLinks['pt-br'] && <link rel="alternate" hreflang="x-default" href={alternateLinks['pt-br']} />}

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title="João Bernardo — Blog"
  href={`${SITE_URL}${rssUrl(locale as Locale)}`}
/>

<!-- SEO: JSON-LD Structured Data -->
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
