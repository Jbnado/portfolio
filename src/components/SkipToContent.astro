---
import { t } from '../i18n/utils';

interface Props {
  href?: string;
  label?: string;
  locale?: string;
}

// O rotulo vinha fixo em portugues e o BaseLayout renderizava sem props: o
// PRIMEIRO elemento focavel de /en/ e /es/ estava em portugues. A chave
// nav.skipToContent ja existia nos tres idiomas e nunca era referenciada.
const { href = '#main', locale = 'pt-br', label = t('nav.skipToContent', locale) } = Astro.props;
---

<a href={href} class="skip-to-content">
  {label}
</a>

<style is:global>
  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 10001;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background: var(--color-accent);
    /* O texto sai do token de fundo do turno, nunca de #ffffff literal: no
       turno noturno o acento é verde fósforo claro e branco sobre ele dava
       1.42:1. E este é o link de pular conteúdo — a falha caía exatamente no
       caminho de quem navega por teclado. */
    color: var(--color-bg-primary);
    padding: 0.5rem 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 6px 0;
  }

  .skip-to-content:focus-visible {
    top: 0;
    left: 0;
    outline: none;
  }
</style>
