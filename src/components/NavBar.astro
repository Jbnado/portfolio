---
import ThemeToggle from '../islands/ThemeToggle.tsx';
import MobileNav from '../islands/MobileNav.tsx';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, getCvPath } from '../i18n/utils';

interface Props {
  locale?: string;
  /** URLs absolutas por idioma, repassadas ao seletor de idioma. */
  alternates?: Record<string, string>;
}

const { locale = 'pt-br', alternates } = Astro.props;

const localePrefix = locale === 'pt-br' ? '' : `/${locale}`;

// Na home as âncoras são in-page (#sobre). Fora dela (ex.: página de case study)
// essas seções não existem, então precisam voltar pra home + âncora.
const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '' || path === '/en' || path === '/es';
const hashPrefix = isHome ? '' : `${localePrefix}/`;

const navLinks = [
  { href: `${hashPrefix}#sobre`, label: t('nav.about', locale) },
  { href: `${hashPrefix}#projetos`, label: t('nav.projects', locale) },
  // Caminho absoluto, não âncora. Usa localePrefix e nunca hashPrefix.
  { href: `${localePrefix}/blog`, label: t('nav.blog', locale) },
  { href: `${hashPrefix}#contacto`, label: t('nav.contact', locale) },
];
---

<nav class="navbar" aria-label={t('nav.mainNav', locale)}>
  <div class="navbar-container">
    <!-- Logo -->
    <a href={localePrefix || '/'} class="navbar-logo" aria-label={t('nav.goHome', locale)}>
      jb<span class="navbar-logo-dot">.</span>
    </a>

    <!-- Desktop links -->
    <div class="navbar-links">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="navbar-link">
          {label}
        </a>
      ))}
    </div>

    <!-- Actions -->
    <div class="navbar-actions">
      <a
        href={getCvPath(locale)}
        download
        class="navbar-cv"
        aria-label={t('nav.downloadCv', locale)}
      >
        CV ↓
      </a>
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <ThemeToggle client:load />
      <MobileNav
        client:load
        links={navLinks}
        cvHref={getCvPath(locale)}
        openLabel={t('nav.openMenu', locale)}
        closeLabel={t('nav.closeMenu', locale)}
        menuLabel={t('nav.menuLabel', locale)}
      />
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('.navbar');
  if (nav) {
    const onScroll = () => {
      const scrolled = window.scrollY > 100;
      nav.classList.toggle('scrolled', scrolled);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // check initial state
  }
</script>

<style is:global>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
    border-bottom: 1px solid transparent;
  }

  .navbar.scrolled {
    background-color: color-mix(
      in srgb,
      var(--color-bg-primary) 95%,
      transparent
    );
    border-bottom-color: var(--color-border);
    will-change: background-color;
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .navbar-container {
      padding: 1rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .navbar-container {
      padding: 1rem 4rem;
    }
  }

  /* Logo */
  .navbar-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    /* 44px de alvo sem engordar a barra: media 36x30 */
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .navbar-logo-dot {
    color: var(--color-accent);
    display: inline-block;
  }

  .navbar-logo:hover .navbar-logo-dot {
    animation: pulse-dot 400ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* Nav links (desktop only) */
  .navbar-links {
    display: none;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .navbar-links {
      display: flex;
    }
  }

  .navbar-link {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 300ms cubic-bezier(0.25, 0.1, 0.25, 1) 100ms;
  }

  .navbar-link:hover {
    color: var(--color-accent);
  }

  /* Sublinhado por scaleX, não por width: animar width força layout a cada
     quadro, e o DESIGN.md proíbe por nome. transform roda no compositor. */
  .navbar-link::after {
    content: "";
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .navbar-link:hover::after {
    transform: scaleX(1);
  }

  .navbar-link.active {
    color: var(--color-accent);
  }

  .navbar-link.active::after {
    transform: scaleX(1);
  }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* CV button — badge style */
  .navbar-cv {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    background: var(--color-accent);
    /* Era #ffffff literal: 8.18:1 no claro (oxblood escuro) mas 1.42:1 no
       escuro, onde o acento é verde fósforo. O token de fundo do turno dá
       contraste alto nos dois. */
    color: var(--color-bg-primary);
    text-decoration: none;
    transition: background-color 300ms cubic-bezier(0.25, 0.1, 0.25, 1) 100ms;
  }

  /* Área de toque de 44px sem alterar o tamanho visual do botão nem a altura
     da barra. O alvo mede 53x30 desenhado; aqui ele passa a 53x44 no toque. */
  .navbar-cv::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 44px;
  }

  .navbar-cv:hover {
    background: var(--color-accent-hover);
  }

  .navbar-cv:active {
    transform: scale(0.98);
  }

  /* Dark mode — punk */
  .dark .navbar-link {
    font-family: var(--font-mono);
    text-shadow: 0 0 8px rgba(97, 255, 202, 0.3);
  }

  .dark .navbar-link:hover {
    color: #61ffca;
    text-shadow: 0 0 12px rgba(97, 255, 202, 0.6);
  }

  .dark .navbar-link:nth-child(even):hover {
    color: #ff3e3e;
    text-shadow: 0 0 12px rgba(255, 62, 62, 0.6);
  }

  .dark .navbar-logo-dot {
    color: #61ffca;
    text-shadow: 0 0 10px rgba(97, 255, 202, 0.6);
  }

  .dark .navbar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(97, 255, 202, 0.03) 0px,
      rgba(97, 255, 202, 0.03) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    z-index: -1;
  }
</style>
