---
import { t } from '../i18n/utils';

interface Props {
  locale?: string;
  /** URLs absolutas por idioma. Quando ausente, o seletor vai pra home. */
  alternates?: Record<string, string>;
}

const { locale = 'pt-br', alternates } = Astro.props;

const locales = [
  { code: 'pt-br', label: 'PT', fullName: 'Português', path: '/' },
  { code: 'en', label: 'EN', fullName: 'English', path: '/en/' },
  { code: 'es', label: 'ES', fullName: 'Español', path: '/es/' },
];

/**
 * O hreflang já sabe onde mora cada tradução. Reaproveitamos isso aqui, senão
 * trocar de idioma numa página interna jogaria o visitante na home.
 * A URL vem absoluta (SITE_URL é fixo), então viramos caminho pra não pular
 * pra produção durante o `astro dev`.
 */
function hrefFor(code: string, fallback: string): string {
  const absolute = alternates?.[code];
  if (!absolute) return fallback;
  try {
    return new URL(absolute).pathname;
  } catch {
    return absolute;
  }
}

const current = locales.find((l) => l.code === locale) ?? locales[0];
const others = locales.filter((l) => l.code !== locale);

// Comando exibido na statusline (dark) ao trocar de idioma.
const LANG_CMD: Record<string, string> = {
  'pt-br': 'export LANG=pt_BR.UTF-8',
  en: 'export LANG=en_US.UTF-8',
  es: 'export LANG=es_ES.UTF-8',
};
---

<details class="lang-switcher" aria-label={t('language.switch', locale)}>
  <summary class="lang-trigger" aria-haspopup="true">
    <span class="lang-current">{current.label}</span>
    <span class="lang-chevron" aria-hidden="true">▾</span>
  </summary>
  <ul class="lang-dropdown" role="list">
    {others.map((l) => (
      <li>
        <a href={hrefFor(l.code, l.path)} class="lang-option" hreflang={l.code === 'pt-br' ? 'pt-BR' : l.code} aria-label={l.fullName} data-cmd={LANG_CMD[l.code]}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</details>

<style is:global>
  .lang-switcher {
    position: relative;
    list-style: none;
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    /* 44px de alvo: media 42x32 */
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: 6px;
    transition:
      color 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
      border-color 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
    list-style: none;
  }

  .lang-trigger::-webkit-details-marker {
    display: none;
  }

  .lang-trigger::marker {
    display: none;
    content: "";
  }

  .lang-trigger:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .lang-chevron {
    font-size: 0.75rem;
    transition: transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .lang-switcher[open] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.25rem);
    right: 0;
    min-width: 3rem;
    padding: 0.25rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: var(--shadow-md);
    list-style: none;
    z-index: 50;
  }

  .lang-option {
    display: flex;
    align-items: center;
    /* 44px de alvo: media 38x30. Estao empilhadas num menu, entao
       alargar nao atrapalha nada. */
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 4px;
    transition:
      color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
      background-color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .lang-option:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
  }

  .lang-option:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
</style>
