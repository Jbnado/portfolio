---
import { t } from '../i18n/utils';

interface Props {
  problem: string;
  decision: string;
  result: string;
  locale?: string;
  caseUrl?: string;
  title?: string;
}

const { problem, decision, result, locale = 'pt-br', caseUrl, title = '' } = Astro.props;
---

<div class="case-study-content">
  <div class="case-study-section">
    <h4 class="case-study-label">{t('caseStudy.problem', locale)}</h4>
    <p class="case-study-text">{problem}</p>
  </div>
  <div class="case-study-section">
    <h4 class="case-study-label">{t('caseStudy.decision', locale)}</h4>
    <p class="case-study-text">{decision}</p>
  </div>
  <div class="case-study-section">
    <h4 class="case-study-label">{t('caseStudy.result', locale)}</h4>
    <p class="case-study-text">{result}</p>
  </div>
  {caseUrl && (
    <a
      href={caseUrl}
      class="case-study-full"
      aria-label={t('caseStudy.readMoreLabel', locale, { title })}
    >
      {t('caseStudy.readMore', locale)} <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style is:global>
  /* No-JS: native details/summary behavior (default).
     Controle de contorno, não link de rodapé: é a ação primária do card e
     precisa parecer com o que é. O link para a página completa mora dentro do
     corpo expandido e tem peso de link, não de botão — assim os dois nunca
     mais se parecem. */
  .case-study-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.5rem 0.85rem;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    list-style: none;
    transition:
      border-color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
      color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .case-study-trigger:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .case-study-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .case-study-trigger::-webkit-details-marker {
    display: none;
  }

  .case-study-trigger::marker {
    display: none;
    content: "";
  }

  .case-study-chevron {
    display: inline-block;
    font-size: 1rem;
    transition: transform 300ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* Enhanced: animated expansion via JS island.
     A island força `open` no <details> para o conteúdo existir no DOM e poder
     animar. Sem o visibility abaixo, o corpo colapsado continuava focável e
     anunciado por leitor de tela enquanto o aria-expanded dizia "false" — e
     agora que existe um link lá dentro, isso seria um alvo de tab invisível.
     visibility:hidden tira a subárvore da ordem de foco; o delay só na volta
     deixa a altura fechar antes de sumir. */
  .case-study-details.enhanced .case-study-body {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 300ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 300ms;
  }

  .case-study-details.enhanced.open .case-study-body {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 300ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0s;
  }

  .case-study-details.enhanced .case-study-body > * {
    overflow: hidden;
  }

  .case-study-details.enhanced .case-study-content {
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .case-study-details.enhanced.open .case-study-content {
    opacity: 1;
    transition: opacity 200ms ease 100ms;
  }

  .case-study-details.enhanced.open .case-study-chevron {
    transform: rotate(90deg);
  }

  /* Case study content layout */
  .case-study-content {
    padding: 1.5rem 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .case-study-section {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .case-study-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .case-study-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .case-study-text {
      font-size: 1rem;
    }
  }

  /* Link para a página completa — peso de link, dentro do corpo expandido */
  .case-study-full {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    /* 44px de alvo: media 230x18 */
    min-height: 44px;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .case-study-full:hover {
    text-decoration-thickness: 2px;
  }

  .case-study-full:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Dark mode */
  .dark .case-study-trigger {
    text-shadow: 0 0 8px rgba(97, 255, 202, 0.3);
  }
</style>
