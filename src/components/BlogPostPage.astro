---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from './VideoEmbed.astro';
import { t } from '../i18n/utils';
import { formatDateLong, readingMinutes } from '../utils/blog';
import { getPostAlternates, type BlogEntry } from '../utils/blog-content';
import { SITE_URL, blogUrl, blogPostUrl, type Locale } from '../utils/constants';

interface Props {
  entry: BlogEntry;
  locale: Locale;
  prev?: BlogEntry;
  next?: BlogEntry;
}

const { entry, locale, prev, next } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const canonical = `${SITE_URL}${blogPostUrl(data.urlSlug, locale)}`;
const alternates = await getPostAlternates(data.slug);
const ogImage = data.ogImage ?? data.video.thumbnail;
const thumbAlt = `${t('blog.thumbAlt', locale)}: ${data.video.title}`;
const minutes = readingMinutes(entry.body ?? '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.summary,
  inLanguage: locale,
  url: canonical,
  datePublished: data.date,
  dateModified: data.updated ?? data.date,
  image: data.video.thumbnail,
  keywords: data.tags.join(', '),
  author: { '@type': 'Person', name: 'João Bernardo', url: SITE_URL },
  publisher: { '@type': 'Person', name: 'João Bernardo', url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  video: {
    '@type': 'VideoObject',
    name: data.video.title,
    description: data.summary,
    thumbnailUrl: data.video.thumbnail,
    uploadDate: data.date,
    embedUrl: `https://www.youtube-nocookie.com/embed/${data.video.youtubeId}`,
    contentUrl: data.video.url,
    ...(data.video.duration ? { duration: data.video.duration } : {}),
  },
};
---

<BaseLayout
  locale={locale}
  title={data.seoTitle ?? `${data.title} — João Bernardo`}
  description={data.summary}
  canonical={canonical}
  alternates={alternates}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
  showScrollSpy={false}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.date} />
    {data.updated && <meta property="article:modified_time" content={data.updated} />}
    {data.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <article class="post-page blueprint-wrap">
    <div class="post-container">
      <a href={blogUrl(locale)} class="post-back">← {t('blog.back', locale)}</a>

      <header class="post-head">
        <div class="post-meta">
          <time datetime={data.date}>{formatDateLong(data.date, locale)}</time>
          <span aria-hidden="true">·</span>
          <span>{t('blog.readingTime', locale).replace('{count}', String(minutes))}</span>
        </div>
        <h1 class="post-title crt-glow">{data.title}</h1>
        <p class="post-summary">{data.summary}</p>
        {data.tags.length > 0 && (
          <ul class="post-tags" role="list">
            {data.tags.map((tag: string) => <li class="post-tag">#{tag}</li>)}
          </ul>
        )}
      </header>

      <VideoEmbed
        youtubeId={data.video.youtubeId}
        thumbnail={data.video.thumbnail}
        thumbAlt={thumbAlt}
        playLabel={t('blog.playVideo', locale)}
      />

      <div class="post-body case-body">
        <Content />
      </div>

      {data.sources.length > 0 && (
        <section class="post-sources" aria-labelledby="post-sources-title">
          <h2 id="post-sources-title" class="post-sources-title crt-glow">{t('blog.sources', locale)}</h2>
          <p class="post-sources-note">{t('blog.sourcesNote', locale)}</p>
          <ol class="post-sources-list">
            {data.sources.map((source: { title: string; url: string; note?: string }) => (
              <li class="post-source">
                <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
                {source.note && <span class="post-source-note">{source.note}</span>}
              </li>
            ))}
          </ol>
        </section>
      )}

      <footer class="post-foot">
        <a href={data.video.url} target="_blank" rel="noopener noreferrer" class="post-watch">
          {t('blog.watchOnYoutube', locale)} ↗
        </a>
        {(prev || next) && (
          <nav class="post-nav" aria-label={t('blog.title', locale)}>
            {prev && (
              <a href={blogPostUrl(prev.data.urlSlug, locale)} class="post-nav-link">
                <span class="post-nav-label">{t('blog.prevPost', locale)}</span>
                <span class="post-nav-title">{prev.data.title}</span>
              </a>
            )}
            {next && (
              <a href={blogPostUrl(next.data.urlSlug, locale)} class="post-nav-link post-nav-link--next">
                <span class="post-nav-label">{t('blog.nextPost', locale)}</span>
                <span class="post-nav-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>
