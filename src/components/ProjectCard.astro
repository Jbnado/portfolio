---
import TechBadge from './TechBadge.astro';
import CaseStudyContent from './CaseStudyContent.astro';
import { t } from '../i18n/utils';

interface Props {
  number: number;
  title: string;
  description: string;
  techStack: string[];
  startDate: string;
  locale?: string;
  type?: 'project' | 'contribution';
  typeLabel?: string;
  links: {
    github?: string;
    demo?: string;
  };
  caseUrl?: string;
  caseStudy: {
    problem: string;
    decision: string;
    result: string;
  };
}

const { number, title, description, techStack, startDate, locale = 'pt-br', type = 'project', typeLabel, links, caseUrl, caseStudy } = Astro.props;

const displayNumber = String(number).padStart(2, '0');
const year = startDate.slice(0, 4);
---

<article class="project-card" style="position:relative">
  <span class="project-number" aria-hidden="true">{displayNumber}</span>
  <div class="project-content">
    <div class="project-header">
      <h3 class="project-title">{title}</h3>
    </div>
    <div class="project-meta">
      <span class={`project-type-stamp project-type-stamp--${type}`}>{typeLabel}</span>
      <span class="project-year">{year}</span>
      <span class="project-meta-sep" aria-hidden="true">·</span>
      {techStack.map((tech) => <TechBadge name={tech} />)}
    </div>
    <p class="project-description">{description}</p>

    {/* Os links de evidencia sairam do .project-header, onde o
        justify-content: space-between os empurrava para o extremo direito de
        uma linha de 1072px — 300 a 400px de vazio entre a afirmacao e a coisa
        que a verifica. Agora encostam na descricao que verificam. */}
    <div class="project-links">
      {links.github && (
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="project-link"
        aria-label={t('projects.githubLabel', locale, { title })}
      >
        {t('projects.github', locale)} <span aria-hidden="true">↗</span>
      </a>
      )}
      {links.demo && (
        <a
          href={links.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={t('projects.demoLabel', locale, { title })}
        >
          {t('projects.demo', locale)} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>

    <details class="case-study-details">
      <summary class="case-study-trigger" aria-label={t('caseStudy.expandLabel', locale, { title })}>
        <span>{t('caseStudy.expand', locale)}</span>
        <span class="case-study-chevron" aria-hidden="true">›</span>
      </summary>
      <div class="case-study-body">
        <CaseStudyContent
          problem={caseStudy.problem}
          decision={caseStudy.decision}
          result={caseStudy.result}
          locale={locale}
          caseUrl={caseUrl}
          title={title}
        />
      </div>
    </details>
  </div>
  <!-- Menacing decoration -->
  <span class="punk-menacing" style="bottom:-0.75rem;right:1rem;font-size:0.75rem;color:rgba(97,255,202,0.15);--punk-rotate:5deg" aria-hidden="true">gogo</span>
</article>

<style is:global>
  /* Project Card */
  .project-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .project-card:first-child {
    padding-top: 0;
  }

  .project-card:last-child {
    border-bottom: none;
  }

  .project-card:hover {
    border-bottom-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .project-card:hover .project-number {
    color: var(--color-accent);
  }

  .project-card:hover .project-content {
    transform: translateX(4px);
  }

  /* Number — indice de catalogo, nao ranking.
     A 32/40px era o maior elemento de cada linha, e a ordem no projects.json
     nao e cronologica (02 e mais recente que 01) nem agrupada por tipo. Um
     ordinal desse tamanho e lido como classificacao, e afirmava uma que o dado
     nao sustenta. Rebaixado ao degrau de Titulo: o titulo do projeto passa a
     ser a ancora da linha, e o numero volta a ser so numeracao. */
  .project-number {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    line-height: 1;
    padding-top: 0.35rem;
    transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* Content */
  .project-content {
    min-width: 0;
    transition: transform 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .project-header {
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: var(--font-heading-tracking);
  }

  @media (min-width: 768px) {
    .project-title {
      font-size: 1.5rem;
    }
  }

  /* Links */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }

  .project-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* GitHub e Demo mediam 18px de altura e ficavam a 12px um do outro: falham a
     exceção de espaçamento do WCAG 2.2 SC 2.5.8. A área cresce na vertical, que
     é onde há espaço, sem mover o texto nem encostar no vizinho lateral. */
  .project-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 44px;
  }

  .project-link:hover {
    color: var(--color-accent);
  }

  /* Meta */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .project-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent-secondary);
  }

  /* Type stamp: PROJETO vs CONTRIB — ink-stamp look */
  .project-type-stamp {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border: 2px solid currentColor;
    border-radius: 2px;
    line-height: 1.4;
    transform: rotate(-4deg);
  }
  .project-type-stamp--project { color: var(--color-text-secondary); }
  .project-type-stamp--contribution { color: var(--color-accent); }
  .dark .project-type-stamp {
    transform: none;
    text-shadow: 0 0 6px rgba(97, 255, 202, 0.4);
  }
  .dark .project-type-stamp--project { color: var(--color-accent-secondary); }
  .dark .project-type-stamp--contribution { color: var(--color-revolt); }

  .project-meta-sep {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  .project-meta .tech-badge {
    font-size: 0.625rem;
    padding: 0.125rem 0.5rem;
  }

  /* .project-readmore saiu: o link para a página completa agora vive dentro do
     corpo expandido, como .case-study-full. Ele e o gatilho prometiam a mesma
     coisa a 33px de distância, no mesmo mono de 12px. */

  /* Description */
  .project-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    /* Corria os 1072px do grid a 1440px, cerca de 120 caracteres por linha,
       bem além da faixa confortável de 45–75ch. */
    max-width: 70ch;
  }

  @media (min-width: 768px) {
    .project-description {
      font-size: 1rem;
    }
  }

  /* Mobile: stack number above content */
  @media (max-width: 767px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* Dark mode — punk chaos */
  .dark .project-card {
    border-bottom-color: rgba(97, 255, 202, 0.15);
    position: relative;
  }

  .dark .project-card:hover {
    animation: shake-msn 300ms ease-in-out;
    border-bottom-color: rgba(97, 255, 202, 0.4);
  }

  /* JoJo ゴゴゴ menacing hover */
  .dark .project-card::after {
    content: "";
    position: absolute;
    right: -0.5rem;
    top: -0.5rem;
    font-size: 1.25rem;
    color: transparent;
    font-weight: 900;
    writing-mode: vertical-rl;
    letter-spacing: -0.15em;
    pointer-events: none;
    z-index: 20;
  }

  .dark .project-card:hover::after {
    content: "ゴゴゴ";
    color: rgba(97, 255, 202, 0.6);
    text-shadow: 0 0 15px rgba(97, 255, 202, 0.4);
    animation: menacing-float 2s ease-in-out infinite;
  }

  .dark .project-number {
    color: rgba(97, 255, 202, 0.3);
    font-family: var(--font-punk);
  }

  .dark .project-card:hover .project-number {
    color: #61ffca;
    text-shadow:
      0 0 20px rgba(97, 255, 202, 0.5),
      0 0 40px rgba(97, 255, 202, 0.2);
  }

  .dark .project-title {
    font-family: var(--font-punk);
  }

  /* Punch-card header/footer */
  /* As tiras .pc-head / .pc-foot saíram. Fora os furos, tudo que elas mostravam
     era duplicata (o título repetia o h3, o #01 repetia .project-number) ou
     invenção (COL: 80 · ROW: 12, IBM 5081). O card de projeto é linha de
     catálogo, não caixa: o filete inferior já separa um do outro. Os furos de
     cartão perfurado seguem no hero, nos cabeçalhos de case e no card de blog. */
</style>
